# The local verse's settings, and their defaults: what scripts/verse-local.sh setup reads and
# pitchfork.toml runs on.
#
# Change one in ~/.config/verse-local.env, which setup reads after this file, then run setup
# again: it renders the result into ~/.verse/local/local.env, which pitchfork's run lines source, and
# writes the files that carry a setting. Bash syntax; $HOME is yours.
#
# By default all of it is under ~/.verse/local, a dir of its own: a plain `verse up` keeps its store
# in ~/.verse/<host>_<port>, and one sharing this store would share its issuer and its runners.
#
# They are the local column of docs/platform/deployment.md: what each part of a deployment is
# filled in with on one machine.

# Where the binaries are built to: verse, runnerd, verse-call-tool, and the `o` this tree pins. A
# dir of their own, so a verse you put on your PATH is not replaced by this tree's.
VERSE_LOCAL_BIN="$HOME/.verse/local/bin"

# versed's address, and the issuer its tokens name (http://<it>).
VERSE_LOCAL_ADDR="localhost:9797"
# The verse's config: who you are, its address, the issuer it signs as. The CLI and Claude Code's
# MCP server reach the local verse with VERSE_CONFIG set to it.
VERSE_LOCAL_CONFIG="$HOME/.verse/local/config.tony"

# The store: logd and docd on the data dir, which also holds the issuer's key.
VERSE_LOCAL_DATA="$HOME/.verse/local/data"
VERSE_LOCAL_LOGD_ADDR="127.0.0.1:9790"
# docd's client face, which versed dials.
VERSE_LOCAL_DOCD_ADDR="127.0.0.1:9791"
VERSE_LOCAL_DOCD_MOUNT_ADDR="127.0.0.1:9792"
VERSE_LOCAL_STORE_ADMIN_ADDR="127.0.0.1:9793"
# How far back the store keeps every patch; past it a read at a commit is approximate, and a hook
# that reads its subject there is lost. A day, as the eks profile. As logd reads a duration: 36h, 2d, 1w.
VERSE_LOCAL_COMPACTION_CUTOFF="1d"

# The runner: its dir (runner.tony, token, and env, its credentials), where it listens, and the
# name it is registered under.
VERSE_LOCAL_RUNNER_DIR="$HOME/.verse/local/runner"
VERSE_LOCAL_RUNNER_LISTEN="127.0.0.1:9810"
VERSE_LOCAL_RUNNER_NAME="laptop"

# Claude Code's MCP server for the local verse.
VERSE_LOCAL_MCP_NAME="verse-local"
