# The local viff's settings, and their defaults: what scripts/viff-local.sh setup reads and
# pitchfork.toml runs on.
#
# Change one in ~/.config/viff-local.env, which setup reads after this file, then run setup
# again: it renders the result into ~/.viff/local/local.env, which pitchfork's run lines source, and
# writes the files that carry a setting. Bash syntax; $HOME is yours.
#
# By default all of it is under ~/.viff/local, a dir of its own: a plain `viff up` keeps its store
# in ~/.viff/<host>_<port>, and one sharing this store would share its issuer and its runners.
#
# They are the local column of docs/platform/deployment.md: what each part of a deployment is
# filled in with on one machine.

# Where the binaries are built to: viff, runnerd, viff-call-tool, viff-secret-exec, and the
# `o` this tree pins. A
# dir of their own, so a viff you put on your PATH is not replaced by this tree's.
VIFF_LOCAL_BIN="$HOME/.viff/local/bin"

# viffd's address, and the issuer its tokens name (http://<it>).
VIFF_LOCAL_ADDR="localhost:9797"
# The viff's config: who you are, its address, the issuer it signs as. The CLI and Claude Code's
# MCP server reach the local viff with VIFF_CONFIG set to it.
VIFF_LOCAL_CONFIG="$HOME/.viff/local/config.tony"

# The store: logd and docd on the data dir, which also holds the issuer's key.
VIFF_LOCAL_DATA="$HOME/.viff/local/data"
VIFF_LOCAL_LOGD_ADDR="127.0.0.1:9790"
# docd's client face, which viffd dials.
VIFF_LOCAL_DOCD_ADDR="127.0.0.1:9791"
VIFF_LOCAL_DOCD_MOUNT_ADDR="127.0.0.1:9792"
VIFF_LOCAL_STORE_ADMIN_ADDR="127.0.0.1:9793"
# How far back the store keeps every patch; past it a read at a commit is approximate, and a hook
# that reads its subject there is lost. A day, as the eks profile. As logd reads a duration: 36h, 2d, 1w.
VIFF_LOCAL_COMPACTION_CUTOFF="1d"

# The runner: its dir (runner.tony, token, and env, its credentials), where it listens, and the
# name it is registered under.
VIFF_LOCAL_RUNNER_DIR="$HOME/.viff/local/runner"
VIFF_LOCAL_RUNNER_LISTEN="127.0.0.1:9810"
VIFF_LOCAL_RUNNER_NAME="laptop"

# Claude Code's MCP server for the local viff.
VIFF_LOCAL_MCP_NAME="viff-local"
