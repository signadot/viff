# The coderunner's own config — not an entity. verse installs a runner as a url and nothing
# else, so what a runner can be asked for is the runner's to declare and the operator's to
# deploy (docs/runners.md).
#
#   go run ./docs/reference/examples/coderunner -config docs/reference/examples/coderunner/coderunner.tony
#
# A spawn names an environment by name and verse carries the name without resolving it — the
# same indirection `driver:` already is.

default: local

# External programs this runner can drive, named by `driver:` on a spawn.
agents:
  claude:
    argv: [claude, "-p", "$prompt", "--output-format", json, "--permission-mode", bypassPermissions]
    resume: ["--resume", "$session"]
    output: json

environments:

# The repositories a task works in are the SPAWN's to say, not this file's: a charter writes
# `repos:` beside its prompt, and a person writes `verse task run -repos repos.tony`. Each names
# `repo` (`owner/name` at GitHub, or a git url or path), `access` (`read`, or `write`), `from`
# (the branch it starts at; omitted is the default branch), and `push`: `new` are patterns for
# branches the run may create (its own, rewritable and deletable by later runs), `existing` are
# branches it may update, and only `force: true` lets it rewrite one of those. A task's own
# branch is `verse/auto/<task>`, which is what a push with no branch sends. A task names a
# BRANCH, and the runner checks it against this before a credential moves.
#
# The work is usually a change to one tree that only makes sense against another — a service
# and the library it consumes, a generator and the code it generates — so `repos` is a list, and
# they land side by side under one working directory: `verse/task/loop.go` and
# `tony-format/ir/node.go` are both just paths to the agent.
#
#   repos:
#   # The one being changed, with the branches a task may push to.
#   - repo: signadot/verse
#     access: write
#     push:
#       new: ["verse/auto/*"]
#       # Somewhere with a consequence, fast-forward only. Nothing here makes this safe on its
#       # own — what does is a charter that ASKs on it (`resources: [{kind: gitref, pattern:
#       # "refs/heads/main"}]`) and `receive.denyNonFastForwards` at the receiving end, which is
#       # the rule verse deliberately does not duplicate: humans push here too, and an invariant
#       # enforced by the receiver applies to all of them.
#       existing: [main]
#   # There to be read. No `access: write`, so nothing can go back to it — a reference
#   # repository that could push is a blast radius nobody asked for.
#   - repo: signadot/tony-format
#
# What an environment holds is the deployment's half: which agent runs the work, what may run
# against the checkout, what its shell inherits, and what it may reach.

# The one you can run right now: `verse task run -repos` naming this checkout (`repo: "."`),
# nothing pushed anywhere.
- name: local
  driver: llm
  env: [PATH, HOME, USER, LANG]

# What a real one looks like: an agent program with git and Go in its PATH.
- name: verse-dev
  driver: claude
  # The ceiling: which binaries the task's PATH holds. It is a claim about the IMAGE, and
  # nothing here checks the image agrees — an environment naming `go` in an image without it
  # produces a task whose commands are not found and no better diagnosis than confusion.
  commands: [git, go, make, gofmt]
  # The passthrough allowlist. Everything else is UNSET — which is the point, since the runner's
  # own environment carries the git token and the model credentials.
  env: [PATH, HOME, USER, LANG]

# What a restricted egress looks like, and the point of it.
#
# Declaring `egress:` IS declaring a restricted network — derived from the list so the two cannot
# disagree, and "restricted" with no list would be a claim with no content.
# It is built by unsharing the network and binding in one socket that reaches an allowlisting
# proxy on the runner's side, so the task's only route out is through this list.
#
# That is what bounds a secret once it is INSIDE the sandbox, which is where the model key has to
# be. A key in a box that can only reach the model API is bounded; the same key in a box that can
# reach anything is not.
#
# THIS ENVIRONMENT WILL NOT RUN under `-confine host`: an unconfined process cannot have its
# network taken away, so the launch is refused rather than the proxy started and the task left
# free to ignore it.
# That refusal is the feature. Run it under `-confine bwrap` on Linux, or see deploy/coderunner.
- name: verse-dev-hardened
  driver: llm
  tools: [read_file, list_dir, write_file]
  env: [PATH, HOME, USER, LANG]
  egress:
  # The model API, through Portkey: without it the llm driver cannot make its one call.
  - api.portkey.ai
  # The Go module path, because a task that cannot build cannot verify.
  - proxy.golang.org
  - sum.golang.org
  # A wildcard covers subdomains and NOT the bare domain, which are different names and often
  # different owners.
  - "*.githubusercontent.com"
