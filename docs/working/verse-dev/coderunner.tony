# verse-dev drive: the coderunner's config for phase 1 (docs/working/verse-dev-coderunner.md).
#
#   go run ./docs/reference/examples/coderunner \
#     -config docs/working/verse-dev/coderunner.tony -data ~/.verse-coderunner -addr :9802
#
# Drive scratch. It names one machine's checkout, so it is here to be read and copied rather
# than run as-is — change `repo` to your own clone before anything works.

default: verse-docs

# The external programs this runner can drive, by the name a spawn writes in `driver:`. Nothing
# in the runner knows what a coding agent is — only how to run a program and read what it said.
agents:
  claude:
    argv: [claude, "-p", "$prompt", "--output-format", json, "--permission-mode", bypassPermissions]
    # How a later turn continues the same conversation. Without it a program gets exactly one
    # turn, so a steer has nowhere to go and an answer that misses its contract cannot be
    # repaired.
    resume: ["--resume", "$session"]
    output: json

# Where the llm driver's model credentials come from. NAMES of environment variables, not
# values: this file is read and copied, and verse's own configured creds live in another
# process where this runner cannot see them.
#
# The model is named here rather than left to `OPENAI_MODEL`, which is only the fallback for a
# harness client built with nothing passed to it — this runner always passes, because it resolves
# `llm:` on its own side and sends values to the task process. Kept the same as
# deploy/coderunner/coderunner.yaml, so driving this locally and driving it on staging are not
# quietly two different experiments.
llm:
  apiKeyEnv: PORTKEY_API_KEY
  virtualKeyEnv: PORTKEY_VIRTUAL_KEY
  model: claude-sonnet-5

environments:

# verse, working on verse. One repository: the task both reads the docs and edits them, so
# there is no reference tree to add yet — phase 2 is where a second one shows up.
- name: verse-docs
  repos:
  - name: verse
    repo: "/Users/scott/Dev/github.com/signadot/verse"
    # The branch, not main. Every doc this drive could find drift in has been changed on
    # `git-coding-runner` and not on main, so a task based on main checks prose against code
    # that has had no reason to diverge from it — which is why two runs came back clean.
    base: git-coding-runner
    # A LOCAL ref for the first generations. The branch lands in the same repository the task
    # read, where a person can diff it, and nothing reaches a remote until somebody has.
    # Phase 4 is the step that changes this, and it is gated for that reason.
    push: "refs/heads/verse/auto/$sha/$task"
  # The harness, not the agent binary. A foreign agent is opaque, so a vector has two
  # positions for it — invoke or do not — and neither the actions it takes nor its reasoning
  # reach the read plane. Every tool below is an action the vector sees, gates and narrates,
  # which is the autonomy dial actually working rather than being nominally present.
  driver: llm
  # The FLOOR: no shell. read_file/list_dir/write_file are confined to the workspace by
  # construction (harness.safePath refuses a path resolving outside the root); run_bash is
  # the one tool that can leave, and a docs task does not need it. This is the containment
  # that is available today, on a Mac, without a kernel feature.
  tools: [read_file, list_dir, write_file]
  # The ceiling, as a claim about this machine rather than an image. Nothing enforces it yet
  # (see confine.go): the task's PATH is not built from it until `filesystem.scope: private`
  # is real, so today it documents intent and is worth keeping honest anyway.
  commands: [git, go, make, gofmt, rg]
  # Everything not named here is UNSET for the agent. The runner's own credentials — model
  # keys, git tokens — are not on this list and that is the point.
  # USER is load-bearing and not decoration: the agent binary looks its credential up by
  # OS user, so without it every turn fails "Not logged in". Found by the run, not by reading.
  env: [PATH, HOME, USER, LANG, TERM]
