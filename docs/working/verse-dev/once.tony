at: verse-dev.once
reads: [ !verse-path [git] ]
---
- name: reflected
  level: 0
  match:
    system: git
- name: derived
  level: 10
  match:
    path: [ verse-dev once ]
---
# A COOPERATIVE ONCE. An operator writes the entity — `verse data verse-dev.once.drift --put
# '{}' --create`, which is the write-once verse already has — and this fires exactly once
# against it: it reads main's tip and latches itself out of its own selection by writing it.
#
# The latch is `!not.has-path sha` rather than `!not {sha: null}`. Both work today (driven:
# a bare null now survives a store round trip and a restart, so the warning in
# comment-drift.tony about absence being unstorable is stale), but the has-path spelling says
# what it means without leaning on how null is stored.
- name: once
  stratum: derived
  condition:
    subject:
      path: [verse-dev once *]
      value: !not.has-path sha
  action:
    patch:
      sha: !get-path { at: [git, verse, head], path: sha }
