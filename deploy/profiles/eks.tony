# verse on EKS. The stateful docd tier on a dynamic gp3 volume; the stateless versed floats over
# the cluster. This profile is the shape; a deployment keeps its own copy with its values filled
# in, outside this repository, and passes it as a file: `o build deploy -p <path>` and
# `make deploy PROFILE=<path>` both take one. The knobs and what each means: deploy/README.md.
env:
  # The cluster this profile is FOR, as a kubectl context name, so `make deploy` goes there and
  # not wherever the shell happens to point. "" is the current context.
  kubeContext: ""
  # The image, incl. tag: a repository of your own, pushed with `make push PUSH_IMAGE=<ref>
  # IMAGE_ARCH=amd64`. Deploy at an immutable ref (`IMAGE=<ref>:<commit>`) rather than a moving
  # tag: a node that has pulled a tag once keeps it, and a rollout then reports success on the
  # binary from before it.
  image: "signadot/verse:latest"
  # A pull Secret that already exists in the namespace, for a private registry; "" attaches none.
  imagePullSecret: ""
  # The cluster's gp3 class, which the EBS CSI driver backs. On a cluster that has none,
  # `emitStorageClass: true` emits a `verse-gp3` class (WaitForFirstConsumer), which still needs
  # the driver addon with node-role IAM to create and attach volumes.
  storageClassName: "gp3"
  emitStorageClass: false
  # The size a NEW claim is made at. A claim that stands is grown in place, which gp3 allows; the
  # template on a StatefulSet that exists cannot change (deploy/README.md, Storage).
  storageSize: "30Gi"
  # Compaction cutoff: longer than the gates, hooks and sequence steps that read at an old commit
  # usually wait.
  docdCompactionCutoff: "1d"
  # Placement. A dedicated node pool for docd (`<docdPoolLabel>=<x>`, tolerating its taint), and
  # whether versed may prefer spot capacity: it is stateless, so it may.
  docdPool: ""
  docdPoolLabel: "verse/pool"
  spotVersed: true
  # docd's memory, from its measured footprint (deploy/README.md, Knobs): the request above its
  # high-water mark, the limit about twice that and under the node, the Go heap ceiling under the
  # limit.
  docdMemoryRequest: "3Gi"
  docdMemoryLimit: "5Gi"
  docdGoMemLimit: "3500MiB"
  # The API and docd's client face on a tailnet, through the Tailscale operator; off without one.
  tailscaleExpose: false
  # Credentials are Secrets this deploy NAMES and does not carry. Each knob names an entry in the
  # ClusterSecretStore (`secretStore`, aws-secretsmanager by default) and emits an ExternalSecret
  # that materialises it; "" emits none and leaves the Secret yours to create by hand. The keys
  # each entry must hold: deploy/README.md, Credentials. Name an entry only once it exists: an
  # ExternalSecret for a missing entry is a Secret that never appears, and for Slack a pod that
  # does not start.
  llmSecretKey: ""         # e.g. "<deployment>/verse/llm"
  gitSecretKey: ""         # "<deployment>/verse/git"
  runnerSecretKey: ""      # "<deployment>/verse/verse-runner"
  codexSecretKey: ""       # "<deployment>/verse/codex"
  claudeSecretKey: ""      # "<deployment>/verse/claude"
  slackSecretKey: ""       # "<deployment>/verse/slack"
  linearSecretKey: ""      # "<deployment>/verse/linear"
  githubSecretKey: ""      # "<deployment>/verse/github"
  # versed does not start without the verse-issuer Secret (an RSA key, `openssl genrsa 2048`,
  # as `issuer.pem`): what it signs its own tokens with, toward each runner and for each gate.
  issuerSecretKey: ""      # "<deployment>/verse/issuer"
  # Who a request is from (deploy/auth/eks.tony): people as they say they are, binding their
  # Slack and GitHub accounts by the nonce `verse account -link` gives them; the iods and the
  # runners by their pods' projected tokens, with the cluster's OIDC issuer.
  authConfig: "auth/eks.tony"
  iodTokens: true
  runnerTokens: true
  # The iods, each off until its credential entry exists. The git iod mirrors `gitMirror`; the
  # github iod reads `githubRepos`; `gitAsApp` and `githubOut` make both act as a GitHub App
  # (deploy/README.md, The GitHub App).
  gitIod: false
  gitMirror: "https://github.com/signadot/verse.git"
  gitAsApp: false
  gitIssueIod: false
  githubIod: false
  githubRepos: "signadot/verse"
  githubOut: false
  slackIod: false
  linearIod: false
  # The rule that reaches each person the asks waiting on them, installed as the system
  # (docs/reference/examples/gate-ask): a copy with your Slack workspace in it, under deploy/.
  systemCharter: ""
  # The runners, each its own image: scripts and the verse agent on the verse runner, codex and
  # claude on theirs. versed hosts nothing itself.
  runner: false
  runnerImage: "signadot/verse-runner:latest"
  # Each runner's config, a file of yours under deploy/: the manifest's ceilings are placeholders
  # (deploy/README.md, "Its ceilings are placeholders").
  runnerConfig: ""
  localRunner: false
  codexRunner: false
  codexRunnerImage: "signadot/verse-runner:codex"
  codexRunnerConfig: ""
  claudeRunner: false
  claudeRunnerImage: "signadot/verse-runner:claude"
  claudeRunnerConfig: ""
  # The admin group, SEEDED at the first start on a store with no root record; membership is
  # changed live after that (`verse group add admin …`).
  permsAdmins: ""          # "admin@example.com"
