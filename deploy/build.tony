# verse — Kubernetes deploy (an `o build`).
#
#   o build deploy | kubectl apply -f -
#   o build deploy -p minikube | kubectl apply -f -
#   o build deploy -p eks | kubectl apply -f -
#
# Split topology: a docd StatefulSet (logd+docd on a data volume — the AZ-pinned stateful
# tier) and a versed Deployment (the stateless singleton engine that attaches to docd and
# floats). Storage shape is per-profile: a dynamic PVC by default, a host mount on minikube,
# EBS gp3 on eks. Sources are the base manifests in source/; env is injected via patches.
# See deploy/README.md.
build:
  env:
    namespace: verse
    # The cluster this profile is FOR, as a kubectl context name. `kubectl apply` otherwise
    # goes wherever your shell happens to point, which makes `make deploy PROFILE=<name>` a
    # function of ambient state — and the command that deploys staging to staging is character
    # for character the command that deploys it to production. Naming it here makes the
    # manifests and the cluster travel together. "" falls back to the current context, which is
    # right for minikube and for anyone whose cluster this file has never heard of.
    kubeContext: ""
    # Full image ref incl. tag (build/Dockerfile). Override: -e image=localhost:5000/verse:dev
    image: "signadot/verse:latest"
    # Container imagePullPolicy. "" = leave the k8s default (Always for :latest, else
    # IfNotPresent). minikube/Docker Desktop use a locally-loaded image → set Never.
    imagePullPolicy: ""
    # The name of an image pull secret for a private registry. NOT created here — this names
    # a Secret that already exists in the namespace, because a registry credential is not
    # something a checked-in manifest should be carrying. It may arrive on its own (a
    # ClusterExternalSecret that fans one into every namespace, say); see
    # deploy/README.md. "" attaches none.
    imagePullSecret: ""
    storageSize: "10Gi"

    # docd storage. The StatefulSet always uses a volumeClaimTemplate; only what BACKS the
    # PVC varies:
    #   default  — the cluster default StorageClass (dynamic).
    #   eks      — a named StorageClass (dynamic EBS); set storageClassName + emitStorageClass.
    #   minikube — a static hostPath PersistentVolume (set hostPV; class becomes "").
    storageClassName: ""
    # Emit a verse-gp3 StorageClass (WaitForFirstConsumer, ebs.csi.aws.com). Needs the EBS
    # CSI driver addon on the cluster.
    emitStorageClass: false
    # hostPV: back the PVC with a static hostPath PersistentVolume (minikube/Docker Desktop).
    hostPV: false
    # The PV's in-VM host path. Docker Desktop: /run/desktop/mnt/host/Users/<you>/.verse/...
    # minikube-mount: the node mount target (e.g. /mnt/verse). See deploy/README.md.
    hostPath: "/mnt/verse"

    # Placement. docd goes on a dedicated node pool: nodes labelled <docdPoolLabel>=<docdPool>
    # and tainted with the same key/value, so the label selects the pool and the toleration
    # gets past the fence that keeps everything else off it. "" leaves docd wherever it lands.
    # versed is stateless, so it only PREFERS spot (label eks.amazonaws.com/capacityType) —
    # a preference costs nothing on a cluster that has no such label.
    docdPool: ""
    # The label and taint key that names the pool, the same on both.
    docdPoolLabel: "verse/pool"
    spotVersed: false

    # docd memory. "" on both leaves the container with no request and no limit, which is
    # right on a laptop profile — a request is a RESERVATION, and one sized for a cluster
    # makes the pod unschedulable on minikube.
    #
    # On a cluster it is not right, and the reason is measured. `o sys up` holds logd and
    # docd in one process, and a catch-up is read into memory before it is emitted: logd
    # materialises every patch in the replayed range, and a whole-verse replay of a large
    # store is the size of the log. With no request the pod is BestEffort — first in line
    # when the kubelet needs memory back, and free to take the node with it on the way. On
    # staging (a 7.2Gi node) it did exactly that: four evictions in fifteen minutes at
    # 3.7–7.1Gi, each one taking the store down, while its steady footprint was 1.8Gi
    # (git-issue 3qf2z59dh12ksdazg9n0).
    #
    # A limit does not prevent the read — it decides who dies of it. Over the limit the
    # container is OOM-killed and says so in its own status; over the node the kubelet
    # evicts whatever it can and the reason lands on the node instead. Same downtime, an
    # attributable cause, and the neighbours survive.
    docdMemoryRequest: ""
    docdMemoryLimit: ""

    # docd's Go heap ceiling (GOMEMLIMIT), "" to leave the runtime unbounded. A cgroup limit
    # is invisible to the Go runtime: with GOGC alone the collector targets twice the live
    # heap and will happily aim past the limit, so the container is killed mid-collection
    # rather than collecting harder. GOMEMLIMIT is the soft ceiling that makes it collect
    # harder, and docdMemoryLimit stays the hard backstop underneath the node.
    #
    # Set it BELOW docdMemoryLimit with room for what is not Go heap — stacks, the runtime's
    # own bookkeeping, and the index's encode buffer during a snapshot. Two thirds to three
    # quarters of the cgroup limit is the range; read /proc/1/status and the heap profile in
    # the pod before moving it rather than picking a number.
    docdGoMemLimit: ""

    # docd's compaction cutoff, "" to leave compaction off — which is logd's default, and on a
    # long-lived store means every root snapshot ever written stays on the disk. Snapshots bound
    # what a read replays, not what the volume holds: on staging a root snapshot is ~16MB and one
    # lands every 1000 commits or 4MiB of delta, and that filled 10Gi in eleven days with
    # compaction off (git-issue hkh7km3th12ksxfdqsn0).
    #
    # Inside the cutoff every patch is kept, so a replay or a read at a commit is exact; past it
    # history thins to logd's snapshot tiers, and a read there is answered approximately
    # (tony-format cpqj2tf6h12kr5jxqxn0 has logd answer it at a nearby snapshot and report which,
    # for verse's AsOf to hold to its contract; until then it says nothing). verse reads at a firing's causing
    # commit when the action runs — after a gate, at a hook, at a sequence step — so the cutoff
    # wants to be longer than any of those waits, not as short as `verse up`'s 1h.
    #
    # Set, it is a ConfigMap (deploy/docd-config) passed to `o sys up` as -config. Only the
    # cutoff is stated; the tiers and the snapshot policy stay upstream's.
    docdCompactionCutoff: ""

    # Put the versed API and docd's client face on the tailnet, through the Tailscale
    # Kubernetes operator — which has to be installed already; these are just annotations it
    # watches for, and nothing here notices if nobody is watching. The devices are named after
    # the namespace (verse, verse-docd), so a second deploy under another namespace does not
    # collide. tailscaleTags is for a tailnet whose ACL wants its own tag rather than the
    # operator's default tag:k8s; "" leaves the default.
    tailscaleExpose: false
    tailscaleTags: ""

    # ── Credentials by reference ──────────────────────────────────────────────
    #
    # Each names the entry in a secret store that becomes one of the Secrets this deploy
    # already expects, via an ExternalSecret (deploy/secrets/). "" emits none, and the Secret
    # is yours to create by hand — which is the answer on a cluster with no External Secrets
    # Operator, and why nothing here is required.
    #
    # One knob per credential rather than one for all of them, because they are held by
    # different processes and revoked on different days: two sources' tokens can be the same
    # secret and should still be two entries, so taking one away does not take the other.
    #
    # The entry's OWN key names land in the Secret verbatim — deploy/README.md tabulates what
    # each consumer reads. An entry that spells them differently syncs green and configures
    # nothing.
    secretStore: "aws-secretsmanager"
    llmSecretKey: ""
    gitSecretKey: ""
    slackSecretKey: ""
    linearSecretKey: ""
    githubSecretKey: ""
    runnerSecretKey: ""
    codexSecretKey: ""
    claudeSecretKey: ""
    issuerSecretKey: ""
    # The runners' secret store (verse-runner-secrets): an entry whose keys are the store's
    # names, each a file at /secrets/<key> in the three runners, for a credential no other
    # Secret holds. The Linear and Slack tokens reach the store from their own Secrets, so this
    # is empty on a deployment that performs nothing more than those.
    runnerStoreKey: ""
    # Comma-separated grantees who may take a top-level place (`walter@example.com,agent:ops`).
    # "" is the open verse. See the patch below for how it reaches versed, and what changing it
    # on a running verse takes.
    permsAdmins: ""
    # The model id, when the driver's default (gpt-4o) is not what the credential routes to.
    # A Portkey virtual key resolves to ONE provider, so the model has to be one that provider
    # serves — an Anthropic-backed key asked for gpt-4o fails on every call, and the credential
    # cannot tell you that. Model choice is deployment config, not a secret, so it is here in
    # the open rather than smuggled into the store entry: as an explicit env it also WINS over
    # an OPENAI_MODEL in the Secret, which is the right way round.
    llmModel: ""

    # The verse runner: a place code work RUNS (its own image, bubblewrap containment, a
    # workspace and a process per task). Off by default and independent of everything above —
    # deploying it does not install it, which is `verse runner add verse-runner
    # http://verse-runner:9802` and is somebody's verb for the reason a source's is.
    #
    # Its own image because the two are sized by different things: the runtime image is thin
    # and pinned to the engine, this one carries the toolchain the repositories it serves need
    # to build. A separate REPOSITORY is not required by that — a tag in the same one is
    # cheaper to grant a pull credential access to.
    runner: false
    runnerImage: "signadot/verse-runner:latest"
    # Its configuration, a path as authConfig is (relative to deploy/, or absolute), in place of
    # the one its manifest
    # carries: what it offers and the ceilings it holds each doer's tasks to. "" runs the
    # manifest's, whose ceilings name placeholder repositories, channels and a Linear team, and so
    # reach none of a deployment's own (deploy/README.md, "Its ceilings are placeholders").
    runnerConfig: ""
    # The codex runner beside it: the same runner in an image with Codex in it, offering the codex
    # agent, with its own credential (the verse-codex Secret, from the entry codexSecretKey
    # names). Installing it is
    # `verse runner add codex http://codex-runner:9802 --subject system:serviceaccount:verse:codex-runner`.
    codexRunner: false
    codexRunnerImage: "signadot/verse-runner:codex"
    codexRunnerConfig: ""   # as runnerConfig, for the codex runner
    # The claude runner, the same way: the runner in an image with Claude Code in it, offering
    # the claude agent, with its own credential (the verse-claude Secret, from the entry
    # claudeSecretKey names). Installing it is `verse runner add claude http://claude-runner:9802
    # --subject system:serviceaccount:verse:claude-runner`.
    claudeRunner: false
    claudeRunnerImage: "signadot/verse-runner:claude"
    claudeRunnerConfig: ""  # as runnerConfig, for the claude runner

    # ── Sources: what reflects an external system into the verse ──────────────
    #
    # Each is off by default and independent of the others, because each costs something
    # different to turn on: the git one costs a clone, the other two cost a credential in the
    # cluster. Turning one on deploys the connector; INSTALLING it is still a verb somebody
    # runs (`verse iod add …`), since a registration carries an ownership claim verse checks
    # against what is already standing, and a manifest is not where that conversation happens.
    #
    # The `<x>IOName` knobs are the registration name each will be added under. They are
    # here because the hint url an iod posts deliveries to contains it, so the name has to be
    # decided before the pod starts — and verse 404s a hint for a name it has no registration
    # under, which is how a mismatch announces itself.
    #
    # NAMED AFTER THE CONNECTOR, because this deployment runs one of each. The name is free —
    # two iods may share a root, and then the name is what tells them apart (`git` on the cluster
    # and `git-laptop` somewhere else) — but a name that says nothing more than the root does is
    # a second vocabulary for one fact, and `cluster`, `issues`, `repos` and `teams` were exactly
    # that. A second instance of one connector is where a name earns its keep, and it can say so
    # then.
    gitIod: false
    gitMirror: "https://github.com/signadot/verse.git"
    # The git iod fetches and pushes AS THE GITHUB APP: its three keys, read from the github iod's
    # Secret (verse-github), make the app's installation token the only credential git presents,
    # in place of the `verse-git` PAT, so what it writes (refs/verse/live, the repo-charters
    # reconciler's record) is written as the app. Needs githubSecretKey's entry to carry the app
    # (deploy/README.md, The GitHub App).
    gitAsApp: false

    # The issues `git issue` keeps inside a repository, reflected as `git-issue:*`.
    #
    # This shared gitMirror until somebody wanted otherwise, on the reasoning that the two
    # sources answer different questions about ONE directory. What broke that is a second
    # repository: `git issue` is used in some repositories and not others, so the set worth
    # mirroring for issues is a SUBSET of the set worth mirroring for branches — and the
    # shared knob made the difference unspellable, so the issue source cloned repositories
    # with no issue refs in them and reflected nothing from them.
    #
    # Empty means "whatever gitMirror says", which is what it always did, so a deployment that
    # names no set is unchanged by the split.
    gitIssueIod: false
    gitIssueMirror: ""
    # Whether to reflect each issue's DESCRIPTION BODY. On is `iod`'s own default and the
    # shape a charter reacting to an issue's text needs; off keeps the tracker's structure —
    # id, title, status, labels, links — without its prose.
    #
    # It is a knob rather than a default because the cost is per deployment: bodies are the
    # bulk of what a tracker weighs, and every read of this store returns the whole document
    # today, so a slice nobody reads still shows up in the latency of everything that does.
    gitIssueBodies: true

    slackIod: false
    slackIodName: "slack"
    # "" takes the team name the bot token belongs to — the id prefix every slack:* entity
    # carries and the ownership claim is spelled with.
    slackWorkspace: ""
    # An Ingress for Slack's Events API request url. "" = no Ingress, and the source converges
    # on the periodic resync instead of on delivery.
    slackWebhookHost: ""

    linearIod: false
    linearIodName: "linear"
    # Comma-separated team keys (ENG,OPS); "" is every team the credential can see.
    linearTeams: ""
    linearWebhookHost: ""

    githubIod: false
    githubIodName: "github"
    # Comma-separated repositories (org/name,org/other). Required: a GitHub source with none
    # reflects nothing, claims nothing and never writes, so it refuses to start.
    githubRepos: ""
    # Discussions are GraphQL and carry no ETag, so they are the whole of what a quiet
    # repository costs against the rate limit — and they are opt-in per repository on GitHub's
    # side, so most repositories have none. Off by default; see docs/reference/iod.md.
    githubDiscussions: false
    # The out half: comments, pull requests, merges, reviews, closes, checks and issues asked
    # for under `github.<org>.<name>.out`, as the App. The repo-charters reconciler's question,
    # review and statuses on a pull request to main ride it, and its candidate's issue; off,
    # nothing asked of GitHub is done (docs/reference/iod.md).
    githubOut: false
    githubWebhookHost: ""

    # ingressClassName for the two webhook Ingresses; "" leaves the cluster default.
    ingressClassName: ""

    # A charter versed installs at start AS THE SYSTEM, by path, relative to deploy/ or absolute (VERSE_SYSTEM_CHARTER,
    # internal/config/config.go). "" installs none. It is how a rule that has to read what no person may —
    # every ask, to tell each person the ones waiting on them — gets installed at all: `--as
    # system` over the api is refused. Read at start, so a changed file takes a restart.
    systemCharter: ""

    # Whether versed's own runner hosts work, beside the runners registered with it
    # (VERSE_LOCAL_RUNNER, `localRunner` in internal/config/config.go). False is a central versed: every
    # spawn is routed to a registered runner (docs/runners.md, "Where a spawn runs").
    localRunner: true

    # verse's `auth` block, by path, relative to deploy/ or absolute (VERSE_CONFIG, internal/config/config.go): who verifies
    # people, which iods are trusted for whose accounts, and how the iods prove themselves
    # (docs/reference/up.md). "" leaves versed as it is: a request is whoever it says. The env
    # verse reads (VERSE_PERMS_ADMINS, the model's) still applies over the file. Read at start.
    authConfig: ""
    # Let anyone who reaches the API server read its OpenID discovery document and keys
    # (deploy/issuer-discovery): a ClusterRoleBinding of the issuer-discovery role to the
    # unauthenticated group. A cluster whose issuer is private (minikube's, kubeadm's) grants
    # that to service accounts alone by default, and versed reads the document as nobody; a
    # cluster with a public issuer (EKS) needs none of this. Cluster-scoped, and off by default.
    issuerDiscoveryOpen: false
    # Give the slack, github and git iods a ServiceAccount each and a projected token, audience `verse`,
    # at /var/run/verse/token, named to iod by VERSE_TOKEN_FILE: how an iod proves it is the iod.
    # The token's subject is system:serviceaccount:<namespace>:<iod>, which `auth.iod.accounts` in
    # the auth config maps to the iod's principal. The cluster is the issuer.
    iodTokens: false
    # Versed and its runners prove themselves to each other (deploy/runner-tokens; docs/runners.md,
    # "Who the runner is"). Each deployed runner gets a ServiceAccount and a projected token,
    # audience `verse`, which it answers on the describe and presents at versed's door, and which
    # its registration's `subject` is held to (`verse runner add -subject
    # system:serviceaccount:verse:verse-runner`, as a deployment's repopulate script does); the cluster is the issuer,
    # as for the iods. Versed proves itself the other way: it is an issuer of its own (the auth
    # file's `auth.issuer`, signing with the verse-issuer Secret this mounts into it), and presents
    # to each runner a token minted for that runner alone, so a runner serves this verse and no
    # other, and a token taken at one runner opens no other's door. On by default, since a
    # deployed runner needs it (`runnerd` does not start without the verse it serves and its
    # token), and so versed needs the verse-issuer Secret (`issuerSecretKey`, or made by hand).
    runnerTokens: true
    # The name versed's tokens are issued under, `auth.issuer.url` in the auth file, which each
    # runner holds them to (VERSE_ISSUER). The runner reads the keys at versed's in-cluster url,
    # so this is a name, and the in-cluster url is the plain choice where nothing outside the
    # cluster verifies versed's tokens.
    issuer: "http://verse:9797"

  sources:
  # Namespace first — kubectl applies the stream in order, so namespaced resources must not
  # precede the Namespace (else "namespaces \"verse\" not found" on the first apply).
  - dir: namespace
  # Before the workloads on purpose: a ServiceAccount's imagePullSecrets are copied into a
  # pod when the POD is created, so an account that gains the secret after the Deployment
  # does nothing for the pods already standing.
  - if: '.[ imagePullSecret != "" ]'
    dir: pull-secret
  # Also before the workloads, for the same reason and a different mechanism: envFrom and a
  # secret volume are both read when the POD starts, so a Secret that appears afterwards is a
  # rollout away from being in its consumer's environment — and the Slack connector's secretRef
  # is not optional, so it would not start at all.
  #
  # Unconditional, unlike the dirs below: each file in it deletes itself when its own knob is
  # empty, which is one rule per credential rather than an `if` here that has to name six.
  - dir: secrets
  # Before docd for the same reason: the config is read when the pod starts.
  - if: '.[ docdCompactionCutoff != "" ]'
    dir: docd-config
  # Before versed for the reason the secrets are: a volume is read when the pod starts.
  - if: '.[ systemCharter != "" ]'
    dir: system-charter
  - if: '.[ authConfig != "" ]'
    dir: auth-config
  # Before versed and the runners, since a pod names its ServiceAccount when it is created.
  - if: '.[runnerTokens]'
    dir: runner-tokens
  - dir: source
  # Before the iods, since a pod names its ServiceAccount when it is created.
  - if: '.[iodTokens]'
    dir: iod-tokens
  - if: '.[issuerDiscoveryOpen]'
    dir: issuer-discovery
  - if: '.[emitStorageClass]'
    dir: eks
  - if: '.[hostPV]'
    dir: hostpv
  - if: '.[gitIod]'
    dir: git-iod
  - if: '.[gitIssueIod]'
    dir: git-issue-iod
  - if: '.[slackIod]'
    dir: slack-iod
  - if: '.[linearIod]'
    dir: linear-iod
  - if: '.[githubIod]'
    dir: github-iod
  - if: '.[runner]'
    dir: verse-runner
  - if: '.[codexRunner]'
    dir: codex-runner
  - if: '.[claudeRunner]'
    dir: claude-runner

  patches:
  # The Namespace object's own name.
  - match:
      kind: Namespace
    patch:
      metadata:
        name: $[namespace]

  # Namespace every namespaced resource (StorageClass is cluster-scoped — excluded).
  - match:
      kind: !or [StatefulSet, Deployment, Service, ConfigMap, Secret, Ingress, ServiceAccount, ExternalSecret]
    patch:
      metadata:
        namespace: $[namespace]

  # The store is one patch over all of them — a store name is a property of the cluster, and
  # the same one serves every entry.
  - match:
      kind: ExternalSecret
    patch:
      spec:
        secretStoreRef:
          kind: ClusterSecretStore
          name: $[secretStore]

  # Then the entry, one pair per credential: name it, or delete the ExternalSecret entirely.
  # A pair rather than one patch over `kind: ExternalSecret`, because each names a different
  # entry — and the `!delete null` half is what makes the dir above unconditional.
  - if: '.[ llmSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-llm
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[llmSecretKey]
  - if: '.[ llmSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-llm
    patch: !delete null

  - if: '.[ gitSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-git
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[gitSecretKey]
  - if: '.[ gitSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-git
    patch: !delete null

  - if: '.[ slackSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-slack
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[slackSecretKey]
  - if: '.[ slackSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-slack
    patch: !delete null

  - if: '.[ linearSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-linear
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[linearSecretKey]
  - if: '.[ linearSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-linear
    patch: !delete null

  - if: '.[ githubSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-github
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[githubSecretKey]
  - if: '.[ githubSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-github
    patch: !delete null

  - if: '.[ runnerSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-runner
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[runnerSecretKey]
  - if: '.[ runnerSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-runner
    patch: !delete null

  - if: '.[ codexSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-codex
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[codexSecretKey]
  - if: '.[ codexSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-codex
    patch: !delete null

  - if: '.[ claudeSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-claude
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[claudeSecretKey]
  - if: '.[ claudeSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-claude
    patch: !delete null

  - if: '.[ issuerSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-issuer
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[issuerSecretKey]
  - if: '.[ issuerSecretKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-issuer
    patch: !delete null

  - if: '.[ runnerStoreKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-runner-secrets
    patch:
      spec:
        dataFrom:
        - extract:
            key: $[runnerStoreKey]
  - if: '.[ runnerStoreKey == "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-runner-secrets
    patch: !delete null

  # The pull secret, onto the `default` ServiceAccount every pod here runs as.
  # Every ServiceAccount this deploy emits: `default`, which every pod that names none runs as,
  # and an iod's own (deploy/iod-tokens), which its pod names instead and so would not inherit
  # `default`'s.
  - if: '.[ imagePullSecret != "" ]'
    match:
      kind: ServiceAccount
    patch:
      imagePullSecrets:
      - name: $[imagePullSecret]

  # WHO MAY TAKE A TOP-LEVEL PLACE, as an env because a pod has no verse.tony: comma-separated
  # grantees, seeded into the `admin` group and held `owner` out to beneath the root. Empty is
  # the open verse — anybody takes one — which is what a dogfood deployment runs as.
  #
  # IT SEEDS the admin group, once. After that membership is changed live, by
  # `user:admin@verse` with `verse group add admin …`, as any group's is — so editing this on a
  # running verse changes nothing, by design, and versed does not call a list that differs from
  # the group drift. What it does say at every start is when the FORM of its top (open, or held
  # out to the admin group) is not what this says. `--reseed-perms`, or VERSE_RESEED_PERMS=true
  # for one roll and unset after, rewrites the top from here — live membership edits included.
  - if: '.[ permsAdmins != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: VERSE_PERMS_ADMINS
                value: $[permsAdmins]

  - if: '.[ llmModel != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: OPENAI_MODEL
                value: $[llmModel]

  # A versed that hosts nothing routes every spawn to a registered runner.
  - if: '.[ localRunner == false ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: VERSE_LOCAL_RUNNER
                value: "false"

  # The system charter, mounted where VERSE_SYSTEM_CHARTER says (deploy/system-charter).
  - if: '.[ systemCharter != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: VERSE_SYSTEM_CHARTER
                value: /etc/verse/system-charter/system.tony
              volumeMounts: !key(name)
              - name: system-charter
                mountPath: /etc/verse/system-charter
                readOnly: true
            volumes: !key(name)
            - name: system-charter
              configMap:
                name: verse-system-charter

  # The auth block, mounted where VERSE_CONFIG says (deploy/auth-config). VERSE_CONFIG replaces
  # the file layers verse would otherwise read, none of which a pod has, and the env still applies
  # over it.
  - if: '.[ authConfig != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: VERSE_CONFIG
                value: /etc/verse/config/verse.tony
              volumeMounts: !key(name)
              - name: verse-auth
                mountPath: /etc/verse/config
                readOnly: true
            volumes: !key(name)
            - name: verse-auth
              configMap:
                name: verse-auth

  # A runner's configuration from a file of the deployment's, carried in whole in place of the
  # manifest's (runnerConfig, codexRunnerConfig, claudeRunnerConfig).
  - if: '.[ runnerConfig != "" ]'
    match: {kind: ConfigMap, metadata: {name: verse-runner-config}}
    patch:
      data:
        verse-runner.tony: !file $[runnerConfig]
  - if: '.[ codexRunnerConfig != "" ]'
    match: {kind: ConfigMap, metadata: {name: codex-runner-config}}
    patch:
      data:
        verse-runner.tony: !file $[codexRunnerConfig]
  - if: '.[ claudeRunnerConfig != "" ]'
    match: {kind: ConfigMap, metadata: {name: claude-runner-config}}
    patch:
      data:
        verse-runner.tony: !file $[claudeRunnerConfig]

  # The verse image on both tiers (list-merge each container by name; docd runs `o`, versed
  # runs `verse` — one image, two roles).
  - match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              image: $[image]
  # Named rather than by kind alone, now that the source connectors are Deployments too: a
  # container list-merged BY NAME against a Deployment that has no `versed` in it does not
  # patch, it ADDS one.
  - match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              image: $[image]

  # imagePullPolicy on both tiers (when set) — minikube/Docker Desktop → Never (local image).
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              imagePullPolicy: $[imagePullPolicy]

  # docd memory (see the knobs). Each half is emitted only when it is set, so a profile may
  # reserve without capping or cap without reserving.
  - if: '.[ docdMemoryRequest != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              resources:
                requests:
                  memory: $[docdMemoryRequest]
  - if: '.[ docdMemoryLimit != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              resources:
                limits:
                  memory: $[docdMemoryLimit]
  - if: '.[ docdGoMemLimit != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              env: !key(name)
              - name: GOMEMLIMIT
                value: $[docdGoMemLimit]

  # docd compaction (see the knob). The file is mounted at /etc/logd and named with -config
  # through args, which kubernetes appends to the source's command. The cutoff is also
  # on the pod template, because `o sys up` reads the file once: a changed ConfigMap alone
  # would reach the mount and not the store, and an annotation that changes is a rollout.
  - if: '.[ docdCompactionCutoff != "" ]'
    match:
      kind: ConfigMap
      metadata:
        name: docd-logd-config
    patch:
      data:
        logd.tony: "compaction: {cutoff: $[docdCompactionCutoff]}\n"
  - if: '.[ docdCompactionCutoff != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          metadata:
            annotations:
              verse.signadot.com/compaction-cutoff: $[docdCompactionCutoff]
          spec:
            containers: !key(name)
            - name: docd
              args:
              - -config
              - /etc/logd/logd.tony
              volumeMounts: !key(name)
              - name: logd-config
                mountPath: /etc/logd
                readOnly: true
            volumes: !key(name)
            - name: logd-config
              configMap:
                name: docd-logd-config

  # docd volumeClaimTemplate — always present. Base: no storageClassName (omitting it =
  # "cluster default"; "" would disable dynamic provisioning). eks/minikube override below.
  - match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            resources:
              requests:
                storage: $[storageSize]

  # A named StorageClass (eks: dynamic EBS) — re-emit the VCT with the class.
  - if: '.[ storageClassName != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: $[storageClassName]
            resources:
              requests:
                storage: $[storageSize]

  # minikube: static hostPath PV — class "" binds the VCT to the emitted PersistentVolume.
  - if: '.[hostPV]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: ""
            resources:
              requests:
                storage: $[storageSize]

  # Point the hostPath PV at the host dir, size it, and bind it to docd's namespaced PVC.
  - if: '.[hostPV]'
    match:
      kind: PersistentVolume
    patch:
      spec:
        capacity:
          storage: $[storageSize]
        hostPath:
          path: $[hostPath]
        claimRef:
          namespace: $[namespace]
          name: data-docd-0

  # Pin the stateful docd tier to its node pool. Both halves are needed and neither implies
  # the other: the selector says where docd goes, the toleration is what lets it past the
  # taint that reserves those nodes. A pool named here that the cluster does not label leaves
  # docd Pending — which is the right failure for the tier that owns the data.
  - if: '.[ docdPool != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            nodeSelector:
              pool: $[docdPool]
            tolerations:
            - key: $[docdPoolLabel]
              value: $[docdPool]
              effect: NoSchedule
  # The selector's key is the knob, and a key is not interpolated as a value is: written as
  # `pool` above, then renamed to docdPoolLabel.
  - if: '.[ docdPool != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            nodeSelector: !rename
            - from: pool
              to: $[docdPoolLabel]

  # Let the stateless versed prefer spot.
  - if: '.[spotVersed]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            affinity:
              nodeAffinity:
                preferredDuringSchedulingIgnoredDuringExecution:
                - weight: 100
                  preference:
                    matchExpressions:
                    - key: eks.amazonaws.com/capacityType
                      operator: In
                      values: [SPOT]

  # ── Tailscale ─────────────────────────────────────────────────────────────
  #
  # The versed API. An annotation on the existing Service is all the operator needs — it
  # stands up its own proxy pod and dials this Service's ClusterIP, so nothing about the
  # Service itself changes for in-cluster callers.
  #
  # The hostname is the tailnet device name, i.e. what somebody types (`verse:9797`). It
  # tracks the namespace rather than being fixed, so two verses on one tailnet are two names
  # instead of a name and a name-1 the operator picked.
  - if: '.[tailscaleExpose]'
    match:
      kind: Service
      metadata:
        name: verse
    patch:
      metadata:
        annotations:
          tailscale.com/expose: "true"
          tailscale.com/hostname: $[namespace]

  # docd's client face. Nothing is added to reach it — it is an ordinary Service the deploy
  # always has, and this only annotates it.
  #
  # docd-headless is deliberately absent: the operator refuses a headless Service, recording
  # an INVALIDSERVICE event, and nothing dials it anyway.
  - if: '.[tailscaleExpose]'
    match:
      kind: Service
      metadata:
        name: docd
    patch:
      metadata:
        annotations:
          tailscale.com/expose: "true"
          tailscale.com/hostname: "$[namespace]-docd"
  # …and tell clients so. A client reads an address off verse and connects to it from wherever
  # IT is — which, once the faces are on a tailnet, is somewhere `docd:7071` does not resolve.
  # versed keeps dialling the Service names; only what it PUBLISHES changes, to the tailnet
  # names those same Services now answer to.
  #
  # docd's goes on /status, where a store client beside the cluster looks for it.
  #
  # No knob: this is not a choice, it is the name the device was given just above, spelled
  # from the same namespace. A knob would only be a way to disagree with the annotation.
  - if: '.[tailscaleExpose]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              args:
              - up
              - --docd-addr
              - docd:7071
              - --docd-advertise-addr
              - "$[namespace]-docd:7071"
              - --addr
              - ":9797"

  - if: '.[ tailscaleExpose && tailscaleTags != "" ]'
    match:
      kind: Service
      metadata:
        name: !or [verse, docd]
    patch:
      metadata:
        annotations:
          tailscale.com/tags: $[tailscaleTags]

  # The verse runner's image — its own, so it takes runnerImage rather than image. The pull
  # secret it needs is already handled: it runs as the namespace's `default` ServiceAccount
  # like everything else here, so nothing about a private registry is this deployment's
  # problem. imagePullPolicy tracks the same knob the other tiers do, for the local case.
  - if: '.[runner]'
    match:
      kind: Deployment
      metadata:
        name: verse-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: verse-runner
              image: $[runnerImage]
  - if: '.[ runner && imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: verse-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: verse-runner
              imagePullPolicy: $[imagePullPolicy]

  # The codex runner's image, the same way.
  - if: '.[codexRunner]'
    match:
      kind: Deployment
      metadata:
        name: codex-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: codex-runner
              image: $[codexRunnerImage]
  - if: '.[ codexRunner && imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: codex-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: codex-runner
              imagePullPolicy: $[imagePullPolicy]

  # The claude runner's image, the same way.
  - if: '.[claudeRunner]'
    match:
      kind: Deployment
      metadata:
        name: claude-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: claude-runner
              image: $[claudeRunnerImage]
  - if: '.[ claudeRunner && imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: claude-runner
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: claude-runner
              imagePullPolicy: $[imagePullPolicy]

  # Versed's signing key (runnerTokens): the verse-issuer Secret, mounted where the auth file's
  # `auth.issuer.key` reads it. With it versed signs the token it presents to each runner, minted
  # for that runner's subject alone; without the Secret the pod does not start, which is said in
  # its log rather than found at the first spawn.
  - if: '.[runnerTokens]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              volumeMounts: !key(name)
              - name: verse-issuer
                mountPath: /etc/verse/issuer
                readOnly: true
            volumes: !key(name)
            - name: verse-issuer
              secret:
                secretName: verse-issuer

  # Each runner's own token (runnerTokens): its ServiceAccount, and a projected token with the
  # audience `verse`, answered on the describe to the verse the runner verified and presented at
  # versed's door. `runnerd` reads VERSE_TOKEN_FILE as `iod` does. And the verse the runner
  # serves, which its configuration leaves to the deployment: where it reaches versed and reads
  # its keys (VERSE_URL), and the name versed's tokens are issued under (VERSE_ISSUER, the
  # `issuer` knob). The audience the runner takes them for is its own token's subject.
  - if: '.[ runnerTokens && runner ]'
    match:
      kind: Deployment
      metadata:
        name: verse-runner
    patch:
      spec:
        template:
          spec:
            serviceAccountName: verse-runner
            containers: !key(name)
            - name: verse-runner
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              - name: VERSE_URL
                value: http://verse:9797
              - name: VERSE_ISSUER
                value: $[issuer]
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token
  - if: '.[ runnerTokens && codexRunner ]'
    match:
      kind: Deployment
      metadata:
        name: codex-runner
    patch:
      spec:
        template:
          spec:
            serviceAccountName: codex-runner
            containers: !key(name)
            - name: codex-runner
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              - name: VERSE_URL
                value: http://verse:9797
              - name: VERSE_ISSUER
                value: $[issuer]
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token
  - if: '.[ runnerTokens && claudeRunner ]'
    match:
      kind: Deployment
      metadata:
        name: claude-runner
    patch:
      spec:
        template:
          spec:
            serviceAccountName: claude-runner
            containers: !key(name)
            - name: claude-runner
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              - name: VERSE_URL
                value: http://verse:9797
              - name: VERSE_ISSUER
                value: $[issuer]
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token

  # The source connectors. One image, three roles: these run `iod`, versed runs `verse`,
  # docd runs `o`. Each patch below re-emits the whole `command`, because that is what a list
  # does — and a source's command IS its configuration, so there is nothing to merge into.
  - if: '.[gitIod]'
    match:
      kind: Deployment
      metadata:
        name: git-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-iod
              image: $[image]
              command:
              - iod
              - git
              - -addr
              - ":9801"
              # The SAME damping the github source has always had. A source with none answers a
              # full reflection on every resync, and the resync is a constant — so what bounds
              # the cost is the source's own floor, not verse's interval. It went unnoticed while
              # this mirrored one small repository; a second one made the store the bottleneck
              # and every request on the serialized session started timing out.
              - -min-interval
              - "1m"
              - -state
              - /repos
              - -mirror
              - $[gitMirror]
              # The tree sha of the charters directory on every ref, and the out half that
              # makes the tags and moves the branches the repo-charters reconciler asks for
              # (deploy/git-iod). VERSE_ADDR in the source manifest says where it reads them.
              - -tree
              - .verse/charters
              - -out

  # TWO BLOCKS, one knob: a set of its own when gitIssueMirror names one, and gitMirror's when
  # it does not. A command is a list, so there is nothing to merge into and no way to write a
  # default that a later patch overrides — the same reason llmSecretKey is spelled as a pair.
  - if: '.[ gitIssueIod && gitIssueMirror != "" ]'
    match:
      kind: Deployment
      metadata:
        name: git-issue-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-issue-iod
              image: $[image]
              command:
              - iod
              - git-issue
              - -addr
              - ":9801"
              - -min-interval
              - "1m"
              - -bodies=$[gitIssueBodies]
              - -state
              - /repos
              - -mirror
              - $[gitIssueMirror]

  - if: '.[ gitIssueIod && gitIssueMirror == "" ]'
    match:
      kind: Deployment
      metadata:
        name: git-issue-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-issue-iod
              image: $[image]
              command:
              - iod
              - git-issue
              - -addr
              - ":9801"
              - -min-interval
              - "1m"
              - -bodies=$[gitIssueBodies]
              - -state
              - /repos
              - -mirror
              - $[gitMirror]

  - if: '.[slackIod]'
    match:
      kind: Deployment
      metadata:
        name: slack-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-iod
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/iods/$[slackIodName]/hint"

  # The iod's own credential (iodTokens): its ServiceAccount, and a projected token at the path
  # VERSE_TOKEN_FILE names, asked for with the audience `verse` and rotated by the kubelet. The
  # env rather than a flag, since the command is restated whole by the patch below.
  - if: '.[ iodTokens && slackIod ]'
    match:
      kind: Deployment
      metadata:
        name: slack-iod
    patch:
      spec:
        template:
          spec:
            serviceAccountName: slack-iod
            containers: !key(name)
            - name: slack-iod
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token

  # The workspace label, when the operator would rather name it than take the team's own name.
  - if: '.[ slackIod && slackWorkspace != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-iod
              command:
              - iod
              - slack
              - -addr
              - ":9801"
              - -min-interval
              - "30s"
              - -out
              - -workspace
              - $[slackWorkspace]

  - if: '.[linearIod]'
    match:
      kind: Deployment
      metadata:
        name: linear-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-iod
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/iods/$[linearIodName]/hint"

  - if: '.[githubIod]'
    match:
      kind: Deployment
      metadata:
        name: github-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-iod
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/iods/$[githubIodName]/hint"

  # The git iod as the GitHub App (gitAsApp): the app's keys from the github iod's Secret, which
  # iod git reads as the github iod does (cmd/iod/git.go).
  - if: '.[ gitIod && gitAsApp ]'
    match:
      kind: Deployment
      metadata:
        name: git-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-iod
              env: !key(name)
              - name: GITHUB_APP_ID
                valueFrom: {secretKeyRef: {name: verse-github, key: GITHUB_APP_ID}}
              - name: GITHUB_APP_INSTALLATION_ID
                valueFrom: {secretKeyRef: {name: verse-github, key: GITHUB_APP_INSTALLATION_ID}}
              - name: GITHUB_APP_PRIVATE_KEY
                valueFrom: {secretKeyRef: {name: verse-github, key: GITHUB_APP_PRIVATE_KEY}}

  # The github iod's credential, as the slack iod's above.
  - if: '.[ iodTokens && githubIod ]'
    match:
      kind: Deployment
      metadata:
        name: github-iod
    patch:
      spec:
        template:
          spec:
            serviceAccountName: github-iod
            containers: !key(name)
            - name: github-iod
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token

  # The git iod's credential, as the github iod's: verified, it may relay the person an install is
  # for (`Verse-For-Principal`), which the auth config trusts it to for GitHub accounts.
  - if: '.[ iodTokens && gitIod ]'
    match:
      kind: Deployment
      metadata:
        name: git-iod
    patch:
      spec:
        template:
          spec:
            serviceAccountName: git-iod
            containers: !key(name)
            - name: git-iod
              env: !key(name)
              - name: VERSE_TOKEN_FILE
                value: /var/run/verse/token
              volumeMounts: !key(name)
              - name: verse-token
                mountPath: /var/run/verse
                readOnly: true
            volumes: !key(name)
            - name: verse-token
              projected:
                sources:
                - serviceAccountToken:
                    audience: verse
                    expirationSeconds: 3600
                    path: token

  # The command is restated whole rather than appended to, as the Linear and Slack ones are: a
  # patch that inserted would have to know what it was inserting into, and two of them would
  # each clobber the other's.
  #
  # `-discussions` is spelled `=value` so one patch carries both knobs. A source with no
  # repositories refuses to start, which is why this is conditional on there being some rather
  # than defaulting to a list nobody meant.
  - if: '.[ githubIod && githubRepos != "" ]'
    match:
      kind: Deployment
      metadata:
        name: github-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-iod
              command:
              - iod
              - github
              - -addr
              - ":9801"
              - -min-interval
              - "1m"
              - -repo
              - $[githubRepos]
              - -discussions=$[githubDiscussions]
              - -out=$[githubOut]
              # One out loop per repository, each reporting its pass to verse: at the default 5s
              # that report alone is most of the store's commits. A comment's hint kicks a pass at
              # once, so a minute is what an input written under an outbox waits at most.
              - -out-every
              - "1m"
              # The charters directory an open pull request changes, against its merge base: the
              # repo-charters reconciler asks about that change on the pull request to main.
              - -tree
              - .verse/charters

  - if: '.[ linearIod && linearTeams != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-iod
              command:
              - iod
              - linear
              - -addr
              - ":9801"
              - -min-interval
              - "2m"
              - -team
              - $[linearTeams]

  # imagePullPolicy on the connectors, for the same local-image reason as the two tiers above.
  # One patch each rather than an `!or` over the three names: a keyed-list element has to CARRY
  # its key, so there is nothing for a match over three differently-named containers to merge.
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: git-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-iod
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-iod
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-iod
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-iod
              imagePullPolicy: $[imagePullPolicy]

  # The two webhook Ingresses. A source that cannot be reached from the internet still
  # converges — one resync behind — so an absent host DROPS the Ingress rather than emitting
  # one pointed at nothing.
  - if: '.[ slackWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-iod
    patch:
      spec:
        rules:
        - host: $[slackWebhookHost]
          http:
            paths:
            - path: /slack/events
              pathType: Prefix
              backend:
                service:
                  name: slack-iod
                  port:
                    number: 9801
  - if: '.[ slackWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-iod
    # `!delete null`, not a bare `!delete`: a dangling `:` is not in tony's grammar (an
    # omitted value is the bracketed key-set form, `{a b c}`), and it is accepted only as the
    # LAST pair of a document — so a bare one parses until somebody adds a patch below it.
    # Not `!delete {}` either, which builds but passes an empty object where null was meant.
    patch: !delete null

  - if: '.[ linearWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-iod
    patch:
      spec:
        rules:
        - host: $[linearWebhookHost]
          http:
            paths:
            - path: /linear/webhook
              pathType: Prefix
              backend:
                service:
                  name: linear-iod
                  port:
                    number: 9801
  - if: '.[ linearWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-iod
    patch: !delete null

  # The GitHub one, which had neither half until a staging deploy emitted its Ingress with the
  # base manifest's placeholder host — so `githubWebhookHost` was inert, and the cluster was
  # asked to route `github-iod.example.com` to a Service. A knob that does nothing is worse
  # than an absent one: the deployment says a thing it is not doing.
  - if: '.[ githubWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: github-iod
    patch:
      spec:
        rules:
        - host: $[githubWebhookHost]
          http:
            paths:
            - path: /github/webhook
              pathType: Prefix
              backend:
                service:
                  name: github-iod
                  port:
                    number: 9801
  - if: '.[ githubWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: github-iod
    patch: !delete null

  - if: '.[ ingressClassName != "" ]'
    match:
      kind: Ingress
    patch:
      spec:
        ingressClassName: $[ingressClassName]

