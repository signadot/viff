# verse — Kubernetes deploy (an `o build`).
#
#   o build deploy | kubectl apply -f -
#   o build deploy -p minikube | kubectl apply -f -
#   o build deploy -p staging | kubectl apply -f -
#
# Split topology: a docd StatefulSet (logd+docd on a data volume — the AZ-pinned stateful
# tier) and a versed Deployment (the stateless singleton engine that attaches to docd and
# floats). Storage shape is per-profile: a dynamic PVC by default, a host mount on minikube,
# EBS gp3 on staging. Sources are the base manifests in source/; env is injected via patches.
# See deploy/README.md.
build:
  env:
    namespace: verse
    # Full image ref incl. tag (deploy/Dockerfile). Override: -e image=localhost:5000/verse:dev
    image: "signadot/verse:latest"
    # Container imagePullPolicy. "" = leave the k8s default (Always for :latest, else
    # IfNotPresent). minikube/Docker Desktop use a locally-loaded image → set Never.
    imagePullPolicy: ""
    # Serve + expose the broker face (needed by remote policies / k8s Jobs workers).
    brokerFace: true
    storageSize: "10Gi"

    # docd storage. The StatefulSet always uses a volumeClaimTemplate; only what BACKS the
    # PVC varies:
    #   default  — the cluster default StorageClass (dynamic).
    #   staging  — a named StorageClass (dynamic EBS); set storageClassName + emitStorageClass.
    #   minikube — a static hostPath PersistentVolume (set hostPV; class becomes "").
    storageClassName: ""
    # Emit a verse-gp3 StorageClass (WaitForFirstConsumer, ebs.csi.aws.com). Needs the EBS
    # CSI driver addon on the cluster.
    emitStorageClass: false
    # hostPV: back the PVC with a static hostPath PersistentVolume (minikube/Docker Desktop).
    hostPV: false
    # The PV's in-VM host path. Docker Desktop: /run/desktop/mnt/host/Users/<you>/.verse/...
    # minikube-mount: the node mount target (e.g. /mnt/verse). See deploy/README.md.
    hostPath: "/mnt/verse"

    # Managed-node-group capacity placement (label eks.amazonaws.com/capacityType). Keep the
    # stateful docd on on-demand; let the stateless versed prefer spot.
    onDemandDocd: false
    spotVersed: false

    # ── Sources: what reflects an external system into the verse ──────────────
    #
    # Each is off by default and independent of the others, because each costs something
    # different to turn on: the git one costs a clone, the other two cost a credential in the
    # cluster. Turning one on deploys the connector; INSTALLING it is still a verb somebody
    # runs (`verse source add …`), since a registration carries an ownership claim verse checks
    # against what is already standing, and a manifest is not where that conversation happens.
    #
    # The `<x>SourceName` knobs are the registration name each will be added under. They are
    # here because the hint url a source posts deliveries to contains it, so the name has to be
    # decided before the pod starts — and verse 404s a hint for a name it has no registration
    # under, which is how a mismatch announces itself.
    gitSource: false
    gitMirror: "https://github.com/signadot/verse.git"

    slackSource: false
    slackSourceName: "workspace"
    # "" takes the team name the bot token belongs to — the id prefix every slack:* entity
    # carries and the ownership claim is spelled with.
    slackWorkspace: ""
    # An Ingress for Slack's Events API request url. "" = no Ingress, and the source converges
    # on the periodic resync instead of on delivery.
    slackWebhookHost: ""

    linearSource: false
    linearSourceName: "teams"
    # Comma-separated team keys (ENG,OPS); "" is every team the credential can see.
    linearTeams: ""
    linearWebhookHost: ""

    githubSource: false
    githubSourceName: "repos"
    # Comma-separated repositories (org/name,org/other). Required: a GitHub source with none
    # reflects nothing, claims nothing and never writes, so it refuses to start.
    githubRepos: ""
    # Discussions are GraphQL and carry no ETag, so they are the whole of what a quiet
    # repository costs against the rate limit. false takes a warm pass to zero chargeable
    # requests — see docs/working/gh-source-plan.md.
    githubDiscussions: true
    githubWebhookHost: ""

    # ingressClassName for the two webhook Ingresses; "" leaves the cluster default.
    ingressClassName: ""

  sources:
  # Namespace first — kubectl applies the stream in order, so namespaced resources must not
  # precede the Namespace (else "namespaces \"verse\" not found" on the first apply).
  - dir: namespace
  - dir: source
  - if: '.[emitStorageClass]'
    dir: eks
  - if: '.[hostPV]'
    dir: hostpv
  - if: '.[gitSource]'
    dir: git-source
  - if: '.[slackSource]'
    dir: slack-source
  - if: '.[linearSource]'
    dir: linear-source
  - if: '.[githubSource]'
    dir: github-source

  patches:
  # The Namespace object's own name.
  - match:
      kind: Namespace
    patch:
      metadata:
        name: $[namespace]

  # Namespace every namespaced resource (StorageClass is cluster-scoped — excluded).
  - match:
      kind: !or [StatefulSet, Deployment, Service, ConfigMap, Secret, Ingress]
    patch:
      metadata:
        namespace: $[namespace]

  # The verse image on both tiers (list-merge each container by name; docd runs `o`, versed
  # runs `verse` — one image, two roles).
  - match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              image: $[image]
  # Named rather than by kind alone, now that the source connectors are Deployments too: a
  # container list-merged BY NAME against a Deployment that has no `versed` in it does not
  # patch, it ADDS one.
  - match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              image: $[image]

  # imagePullPolicy on both tiers (when set) — minikube/Docker Desktop → Never (local image).
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              imagePullPolicy: $[imagePullPolicy]

  # docd volumeClaimTemplate — always present. Base: no storageClassName (omitting it =
  # "cluster default"; "" would disable dynamic provisioning). eks/minikube override below.
  - match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            resources:
              requests:
                storage: $[storageSize]

  # staging: a named StorageClass (dynamic EBS) — re-emit the VCT with the class.
  - if: '.[ storageClassName != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: $[storageClassName]
            resources:
              requests:
                storage: $[storageSize]

  # minikube: static hostPath PV — class "" binds the VCT to the emitted PersistentVolume.
  - if: '.[hostPV]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: ""
            resources:
              requests:
                storage: $[storageSize]

  # Point the hostPath PV at the host dir, size it, and bind it to docd's namespaced PVC.
  - if: '.[hostPV]'
    match:
      kind: PersistentVolume
    patch:
      spec:
        capacity:
          storage: $[storageSize]
        hostPath:
          path: $[hostPath]
        claimRef:
          namespace: $[namespace]
          name: data-docd-0

  # Pin the stateful docd tier to on-demand nodes.
  - if: '.[onDemandDocd]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                  - matchExpressions:
                    - key: eks.amazonaws.com/capacityType
                      operator: In
                      values: [ON_DEMAND]

  # Let the stateless versed prefer spot.
  - if: '.[spotVersed]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            affinity:
              nodeAffinity:
                preferredDuringSchedulingIgnoredDuringExecution:
                - weight: 100
                  preference:
                    matchExpressions:
                    - key: eks.amazonaws.com/capacityType
                      operator: In
                      values: [SPOT]

  # The source connectors. One image, three roles: these run `sourced`, versed runs `verse`,
  # docd runs `o`. Each patch below re-emits the whole `command`, because that is what a list
  # does — and a source's command IS its configuration, so there is nothing to merge into.
  - if: '.[gitSource]'
    match:
      kind: Deployment
      metadata:
        name: git-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-source
              image: $[image]
              command:
              - sourced
              - git
              - -addr
              - ":9801"
              - -state
              - /repos
              - -mirror
              - $[gitMirror]

  - if: '.[slackSource]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/slack/$[slackSourceName]/hint"

  # The workspace label, when the operator would rather name it than take the team's own name.
  - if: '.[ slackSource && slackWorkspace != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              command:
              - sourced
              - slack
              - -addr
              - ":9801"
              - -min-interval
              - "30s"
              - -workspace
              - $[slackWorkspace]

  - if: '.[linearSource]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/linear/$[linearSourceName]/hint"

  - if: '.[githubSource]'
    match:
      kind: Deployment
      metadata:
        name: github-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/github/$[githubSourceName]/hint"

  # The command is restated whole rather than appended to, as the Linear and Slack ones are: a
  # patch that inserted would have to know what it was inserting into, and two of them would
  # each clobber the other's.
  #
  # `-discussions` is spelled `=value` so one patch carries both knobs. A source with no
  # repositories refuses to start, which is why this is conditional on there being some rather
  # than defaulting to a list nobody meant.
  - if: '.[ githubSource && githubRepos != "" ]'
    match:
      kind: Deployment
      metadata:
        name: github-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-source
              command:
              - sourced
              - github
              - -addr
              - ":9801"
              - -min-interval
              - "1m"
              - -repo
              - $[githubRepos]
              - -discussions=$[githubDiscussions]

  - if: '.[ linearSource && linearTeams != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              command:
              - sourced
              - linear
              - -addr
              - ":9801"
              - -min-interval
              - "2m"
              - -team
              - $[linearTeams]

  # imagePullPolicy on the connectors, for the same local-image reason as the two tiers above.
  # One patch each rather than an `!or` over the three names: a keyed-list element has to CARRY
  # its key, so there is nothing for a match over three differently-named containers to merge.
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: git-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-source
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              imagePullPolicy: $[imagePullPolicy]

  # The two webhook Ingresses. A source that cannot be reached from the internet still
  # converges — one resync behind — so an absent host DROPS the Ingress rather than emitting
  # one pointed at nothing.
  - if: '.[ slackWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-source
    patch:
      spec:
        rules:
        - host: $[slackWebhookHost]
          http:
            paths:
            - path: /slack/events
              pathType: Prefix
              backend:
                service:
                  name: slack-source
                  port:
                    number: 9801
  - if: '.[ slackWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-source
    # `!delete null`, not a bare `!delete`: a dangling `:` is not in tony's grammar (an
    # omitted value is the bracketed key-set form, `{a b c}`), and it is accepted only as the
    # LAST pair of a document — so a bare one parses until somebody adds a patch below it.
    # Not `!delete {}` either, which builds but passes an empty object where null was meant.
    patch: !delete null

  - if: '.[ linearWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-source
    patch:
      spec:
        rules:
        - host: $[linearWebhookHost]
          http:
            paths:
            - path: /linear/webhook
              pathType: Prefix
              backend:
                service:
                  name: linear-source
                  port:
                    number: 9801
  - if: '.[ linearWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-source
    patch: !delete null

  - if: '.[ ingressClassName != "" ]'
    match:
      kind: Ingress
    patch:
      spec:
        ingressClassName: $[ingressClassName]

  # Drop the broker Service unless the broker face is served.
  #
  # `!delete null` like the two above, and this one is where the trap was found: a bare
  # `!delete` parses while it is the LAST pair of the document, so this patch was fine until
  # a patch was added below it — and then the error pointed at the new patch.
  - if: '.[!brokerFace]'
    match:
      kind: Service
      metadata:
        name: verse-broker
    patch: !delete null
