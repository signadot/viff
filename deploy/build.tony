# verse — Kubernetes deploy (an `o build`).
#
#   o build deploy | kubectl apply -f -
#   o build deploy -p minikube | kubectl apply -f -
#   o build deploy -p staging | kubectl apply -f -
#
# Split topology: a docd StatefulSet (logd+docd on a data volume — the AZ-pinned stateful
# tier) and a versed Deployment (the stateless singleton engine that attaches to docd and
# floats). Storage shape is per-profile: a dynamic PVC by default, a host mount on minikube,
# EBS gp3 on staging. Sources are the base manifests in source/; env is injected via patches.
# See deploy/README.md.
build:
  env:
    namespace: verse
    # Full image ref incl. tag (deploy/Dockerfile). Override: -e image=localhost:5000/verse:dev
    image: "signadot/verse:latest"
    # Container imagePullPolicy. "" = leave the k8s default (Always for :latest, else
    # IfNotPresent). minikube/Docker Desktop use a locally-loaded image → set Never.
    imagePullPolicy: ""
    # The name of an image pull secret for a private registry. NOT created here — this names
    # a Secret that already exists in the namespace, because a registry credential is not
    # something a checked-in manifest should be carrying. On staging one arrives on its own
    # (the signadot-registry ClusterExternalSecret fans it into every namespace); see
    # deploy/README.md. "" attaches none.
    imagePullSecret: ""
    # Serve + expose the broker face (needed by remote policies / k8s Jobs workers).
    brokerFace: true
    storageSize: "10Gi"

    # docd storage. The StatefulSet always uses a volumeClaimTemplate; only what BACKS the
    # PVC varies:
    #   default  — the cluster default StorageClass (dynamic).
    #   staging  — a named StorageClass (dynamic EBS); set storageClassName + emitStorageClass.
    #   minikube — a static hostPath PersistentVolume (set hostPV; class becomes "").
    storageClassName: ""
    # Emit a verse-gp3 StorageClass (WaitForFirstConsumer, ebs.csi.aws.com). Needs the EBS
    # CSI driver addon on the cluster.
    emitStorageClass: false
    # hostPV: back the PVC with a static hostPath PersistentVolume (minikube/Docker Desktop).
    hostPV: false
    # The PV's in-VM host path. Docker Desktop: /run/desktop/mnt/host/Users/<you>/.verse/...
    # minikube-mount: the node mount target (e.g. /mnt/verse). See deploy/README.md.
    hostPath: "/mnt/verse"

    # Placement. docd goes on a dedicated node pool: nodes labelled signadot.com/pool=<x>
    # and tainted with the same key/value, so the label selects the pool and the toleration
    # gets past the fence that keeps everything else off it. "" leaves docd wherever it lands.
    # versed is stateless, so it only PREFERS spot (label eks.amazonaws.com/capacityType) —
    # a preference costs nothing on a cluster that has no such label.
    docdPool: ""
    spotVersed: false

    # Put the versed API and docd's mount face on the tailnet, through the Tailscale
    # Kubernetes operator — which has to be installed already; these are just annotations it
    # watches for, and nothing here notices if nobody is watching. The devices are named after
    # the namespace (verse, verse-mount), so a second deploy under another namespace does not
    # collide. tailscaleTags is for a tailnet whose ACL wants its own tag rather than the
    # operator's default tag:k8s; "" leaves the default.
    tailscaleExpose: false
    tailscaleTags: ""

    # LLM credentials by reference: the entry in a secret store that becomes the `verse-llm`
    # Secret versed envFroms (External Secrets Operator). "" emits nothing — versed runs on
    # the credential-free `scripted` driver, and a hand-made verse-llm works just as well.
    # The entry's own keys are what land in the Secret, so they must be the ones verse reads:
    # PORTKEY_API_KEY, PORTKEY_VIRTUAL_KEY (PORTKEY_BASE_URL, OPENAI_MODEL optional).
    llmSecretKey: ""
    llmSecretStore: "aws-secretsmanager"
    # The model id, when the driver's default (gpt-4o) is not what the credential routes to.
    # A Portkey virtual key resolves to ONE provider, so the model has to be one that provider
    # serves — an Anthropic-backed key asked for gpt-4o fails on every call, and the credential
    # cannot tell you that. Model choice is deployment config, not a secret, so it is here in
    # the open rather than smuggled into the store entry: as an explicit env it also WINS over
    # an OPENAI_MODEL in the Secret, which is the right way round.
    llmModel: ""

    # ── Sources: what reflects an external system into the verse ──────────────
    #
    # Each is off by default and independent of the others, because each costs something
    # different to turn on: the git one costs a clone, the other two cost a credential in the
    # cluster. Turning one on deploys the connector; INSTALLING it is still a verb somebody
    # runs (`verse source add …`), since a registration carries an ownership claim verse checks
    # against what is already standing, and a manifest is not where that conversation happens.
    #
    # The `<x>SourceName` knobs are the registration name each will be added under. They are
    # here because the hint url a source posts deliveries to contains it, so the name has to be
    # decided before the pod starts — and verse 404s a hint for a name it has no registration
    # under, which is how a mismatch announces itself.
    gitSource: false
    gitMirror: "https://github.com/signadot/verse.git"

    slackSource: false
    slackSourceName: "workspace"
    # "" takes the team name the bot token belongs to — the id prefix every slack:* entity
    # carries and the ownership claim is spelled with.
    slackWorkspace: ""
    # An Ingress for Slack's Events API request url. "" = no Ingress, and the source converges
    # on the periodic resync instead of on delivery.
    slackWebhookHost: ""

    linearSource: false
    linearSourceName: "teams"
    # Comma-separated team keys (ENG,OPS); "" is every team the credential can see.
    linearTeams: ""
    linearWebhookHost: ""

    githubSource: false
    githubSourceName: "repos"
    # Comma-separated repositories (org/name,org/other). Required: a GitHub source with none
    # reflects nothing, claims nothing and never writes, so it refuses to start.
    githubRepos: ""
    # Discussions are GraphQL and carry no ETag, so they are the whole of what a quiet
    # repository costs against the rate limit — and they are opt-in per repository on GitHub's
    # side, so most repositories have none. Off by default; see docs/reference/sourced.md.
    githubDiscussions: false
    githubWebhookHost: ""

    # ingressClassName for the two webhook Ingresses; "" leaves the cluster default.
    ingressClassName: ""

  sources:
  # Namespace first — kubectl applies the stream in order, so namespaced resources must not
  # precede the Namespace (else "namespaces \"verse\" not found" on the first apply).
  - dir: namespace
  # Before the workloads on purpose: a ServiceAccount's imagePullSecrets are copied into a
  # pod when the POD is created, so an account that gains the secret after the Deployment
  # does nothing for the pods already standing.
  - if: '.[ imagePullSecret != "" ]'
    dir: pull-secret
  # Also before the workloads, for the same reason and a different mechanism: envFrom is read
  # when the POD starts, so a Secret that appears afterwards is a rollout away from being in
  # versed's environment.
  - if: '.[ llmSecretKey != "" ]'
    dir: llm-secret
  - dir: source
  - if: '.[emitStorageClass]'
    dir: eks
  - if: '.[hostPV]'
    dir: hostpv
  - if: '.[gitSource]'
    dir: git-source
  - if: '.[slackSource]'
    dir: slack-source
  - if: '.[linearSource]'
    dir: linear-source
  - if: '.[githubSource]'
    dir: github-source

  patches:
  # The Namespace object's own name.
  - match:
      kind: Namespace
    patch:
      metadata:
        name: $[namespace]

  # Namespace every namespaced resource (StorageClass is cluster-scoped — excluded).
  - match:
      kind: !or [StatefulSet, Deployment, Service, ConfigMap, Secret, Ingress, ServiceAccount, ExternalSecret]
    patch:
      metadata:
        namespace: $[namespace]

  # Which store, and which entry in it. Both are patched rather than written into the file
  # because a store name is a property of the cluster and the entry is a property of the
  # deployment, and neither is a property of verse.
  - if: '.[ llmSecretKey != "" ]'
    match:
      kind: ExternalSecret
      metadata:
        name: verse-llm
    patch:
      spec:
        secretStoreRef:
          kind: ClusterSecretStore
          name: $[llmSecretStore]
        dataFrom:
        - extract:
            key: $[llmSecretKey]

  # The pull secret, onto the `default` ServiceAccount every pod here runs as.
  - if: '.[ imagePullSecret != "" ]'
    match:
      kind: ServiceAccount
      metadata:
        name: default
    patch:
      imagePullSecrets:
      - name: $[imagePullSecret]

  - if: '.[ llmModel != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              env: !key(name)
              - name: OPENAI_MODEL
                value: $[llmModel]

  # The verse image on both tiers (list-merge each container by name; docd runs `o`, versed
  # runs `verse` — one image, two roles).
  - match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              image: $[image]
  # Named rather than by kind alone, now that the source connectors are Deployments too: a
  # container list-merged BY NAME against a Deployment that has no `versed` in it does not
  # patch, it ADDS one.
  - match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              image: $[image]

  # imagePullPolicy on both tiers (when set) — minikube/Docker Desktop → Never (local image).
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: docd
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              imagePullPolicy: $[imagePullPolicy]

  # docd volumeClaimTemplate — always present. Base: no storageClassName (omitting it =
  # "cluster default"; "" would disable dynamic provisioning). eks/minikube override below.
  - match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            resources:
              requests:
                storage: $[storageSize]

  # staging: a named StorageClass (dynamic EBS) — re-emit the VCT with the class.
  - if: '.[ storageClassName != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: $[storageClassName]
            resources:
              requests:
                storage: $[storageSize]

  # minikube: static hostPath PV — class "" binds the VCT to the emitted PersistentVolume.
  - if: '.[hostPV]'
    match:
      kind: StatefulSet
    patch:
      spec:
        volumeClaimTemplates:
        - metadata:
            name: data
          spec:
            accessModes:
            - ReadWriteOnce
            storageClassName: ""
            resources:
              requests:
                storage: $[storageSize]

  # Point the hostPath PV at the host dir, size it, and bind it to docd's namespaced PVC.
  - if: '.[hostPV]'
    match:
      kind: PersistentVolume
    patch:
      spec:
        capacity:
          storage: $[storageSize]
        hostPath:
          path: $[hostPath]
        claimRef:
          namespace: $[namespace]
          name: data-docd-0

  # Pin the stateful docd tier to its node pool. Both halves are needed and neither implies
  # the other: the selector says where docd goes, the toleration is what lets it past the
  # taint that reserves those nodes. A pool named here that the cluster does not label leaves
  # docd Pending — which is the right failure for the tier that owns the data.
  - if: '.[ docdPool != "" ]'
    match:
      kind: StatefulSet
    patch:
      spec:
        template:
          spec:
            nodeSelector:
              signadot.com/pool: $[docdPool]
            tolerations:
            - key: signadot.com/pool
              value: $[docdPool]
              effect: NoSchedule

  # Let the stateless versed prefer spot.
  - if: '.[spotVersed]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            affinity:
              nodeAffinity:
                preferredDuringSchedulingIgnoredDuringExecution:
                - weight: 100
                  preference:
                    matchExpressions:
                    - key: eks.amazonaws.com/capacityType
                      operator: In
                      values: [SPOT]

  # ── Tailscale ─────────────────────────────────────────────────────────────
  #
  # The versed API. An annotation on the existing Service is all the operator needs — it
  # stands up its own proxy pod and dials this Service's ClusterIP, so nothing about the
  # Service itself changes for in-cluster callers.
  #
  # The hostname is the tailnet device name, i.e. what somebody types (`verse:9797`). It
  # tracks the namespace rather than being fixed, so two verses on one tailnet are two names
  # instead of a name and a name-1 the operator picked.
  - if: '.[tailscaleExpose]'
    match:
      kind: Service
      metadata:
        name: verse
    patch:
      metadata:
        annotations:
          tailscale.com/expose: "true"
          tailscale.com/hostname: $[namespace]

  # docd's two faces. Nothing is added to reach them — they are ordinary Services the deploy
  # always has, and this only annotates them. Two devices rather than one Service with both
  # ports, so an ACL can grant the mount face without granting the store.
  #
  # docd-headless is deliberately absent: the operator refuses a headless Service, recording
  # an INVALIDSERVICE event, and nothing dials it anyway.
  - if: '.[tailscaleExpose]'
    match:
      kind: Service
      metadata:
        name: docd
    patch:
      metadata:
        annotations:
          tailscale.com/expose: "true"
          tailscale.com/hostname: "$[namespace]-docd"
  - if: '.[tailscaleExpose]'
    match:
      kind: Service
      metadata:
        name: docd-mount
    patch:
      metadata:
        annotations:
          tailscale.com/expose: "true"
          tailscale.com/hostname: "$[namespace]-docd-mount"

  # …and tell clients so. /status is where a controller (`verse connect`) reads docd's
  # addresses, and it reads them from wherever IT is — which, once the faces are on a tailnet,
  # is somewhere `docd:7071` does not resolve. versed keeps dialling the Service names; only
  # what it PUBLISHES changes, to the tailnet names those same two Services now answer to.
  #
  # No knob: these are not a choice, they are the names the two devices were given four
  # patches up, spelled from the same namespace. A knob would only be a way to disagree with
  # the annotations.
  - if: '.[tailscaleExpose]'
    match:
      kind: Deployment
      metadata:
        name: versed
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: versed
              args:
              - up
              - --docd-addr
              - docd:7071
              - --docd-mount-addr
              - docd-mount:7072
              - --docd-advertise-addr
              - "$[namespace]-docd:7071"
              - --docd-mount-advertise-addr
              - "$[namespace]-docd-mount:7072"
              - --addr
              - ":9797"
              - --broker-addr
              - ":9090"

  - if: '.[ tailscaleExpose && tailscaleTags != "" ]'
    match:
      kind: Service
      metadata:
        name: !or [verse, docd, docd-mount]
    patch:
      metadata:
        annotations:
          tailscale.com/tags: $[tailscaleTags]

  # The source connectors. One image, three roles: these run `sourced`, versed runs `verse`,
  # docd runs `o`. Each patch below re-emits the whole `command`, because that is what a list
  # does — and a source's command IS its configuration, so there is nothing to merge into.
  - if: '.[gitSource]'
    match:
      kind: Deployment
      metadata:
        name: git-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-source
              image: $[image]
              command:
              - sourced
              - git
              - -addr
              - ":9801"
              - -state
              - /repos
              - -mirror
              - $[gitMirror]

  - if: '.[slackSource]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/slack/$[slackSourceName]/hint"

  # The workspace label, when the operator would rather name it than take the team's own name.
  - if: '.[ slackSource && slackWorkspace != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              command:
              - sourced
              - slack
              - -addr
              - ":9801"
              - -min-interval
              - "30s"
              - -workspace
              - $[slackWorkspace]

  - if: '.[linearSource]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/linear/$[linearSourceName]/hint"

  - if: '.[githubSource]'
    match:
      kind: Deployment
      metadata:
        name: github-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-source
              image: $[image]
              env: !key(name)
              - name: VERSE_HINT_URL
                value: "http://verse:9797/sources/github/$[githubSourceName]/hint"

  # The command is restated whole rather than appended to, as the Linear and Slack ones are: a
  # patch that inserted would have to know what it was inserting into, and two of them would
  # each clobber the other's.
  #
  # `-discussions` is spelled `=value` so one patch carries both knobs. A source with no
  # repositories refuses to start, which is why this is conditional on there being some rather
  # than defaulting to a list nobody meant.
  - if: '.[ githubSource && githubRepos != "" ]'
    match:
      kind: Deployment
      metadata:
        name: github-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: github-source
              command:
              - sourced
              - github
              - -addr
              - ":9801"
              - -min-interval
              - "1m"
              - -repo
              - $[githubRepos]
              - -discussions=$[githubDiscussions]

  - if: '.[ linearSource && linearTeams != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              command:
              - sourced
              - linear
              - -addr
              - ":9801"
              - -min-interval
              - "2m"
              - -team
              - $[linearTeams]

  # imagePullPolicy on the connectors, for the same local-image reason as the two tiers above.
  # One patch each rather than an `!or` over the three names: a keyed-list element has to CARRY
  # its key, so there is nothing for a match over three differently-named containers to merge.
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: git-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: git-source
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: slack-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: slack-source
              imagePullPolicy: $[imagePullPolicy]
  - if: '.[ imagePullPolicy != "" ]'
    match:
      kind: Deployment
      metadata:
        name: linear-source
    patch:
      spec:
        template:
          spec:
            containers: !key(name)
            - name: linear-source
              imagePullPolicy: $[imagePullPolicy]

  # The two webhook Ingresses. A source that cannot be reached from the internet still
  # converges — one resync behind — so an absent host DROPS the Ingress rather than emitting
  # one pointed at nothing.
  - if: '.[ slackWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-source
    patch:
      spec:
        rules:
        - host: $[slackWebhookHost]
          http:
            paths:
            - path: /slack/events
              pathType: Prefix
              backend:
                service:
                  name: slack-source
                  port:
                    number: 9801
  - if: '.[ slackWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: slack-source
    # `!delete null`, not a bare `!delete`: a dangling `:` is not in tony's grammar (an
    # omitted value is the bracketed key-set form, `{a b c}`), and it is accepted only as the
    # LAST pair of a document — so a bare one parses until somebody adds a patch below it.
    # Not `!delete {}` either, which builds but passes an empty object where null was meant.
    patch: !delete null

  - if: '.[ linearWebhookHost != "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-source
    patch:
      spec:
        rules:
        - host: $[linearWebhookHost]
          http:
            paths:
            - path: /linear/webhook
              pathType: Prefix
              backend:
                service:
                  name: linear-source
                  port:
                    number: 9801
  - if: '.[ linearWebhookHost == "" ]'
    match:
      kind: Ingress
      metadata:
        name: linear-source
    patch: !delete null

  - if: '.[ ingressClassName != "" ]'
    match:
      kind: Ingress
    patch:
      spec:
        ingressClassName: $[ingressClassName]

  # Drop the broker Service unless the broker face is served.
  #
  # `!delete null` like the two above, and this one is where the trap was found: a bare
  # `!delete` parses while it is the LAST pair of the document, so this patch was fine until
  # a patch was added below it — and then the error pointed at the new patch.
  - if: '.[!brokerFace]'
    match:
      kind: Service
      metadata:
        name: verse-broker
    patch: !delete null
